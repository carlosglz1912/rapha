# Copy to /etc/systemd/system/rapha-ui.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup.
[Unit]
Description=Rapha UI
After=network.target

[Service]
Type=simple
User=YOURUSER
WorkingDirectory=/home/YOURUSER/rapha
ExecStart=/home/YOURUSER/rapha/venv/bin/uvicorn app:app --port 7000 --host 0.0.0.0
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/rapha/.env

[Install]
WantedBy=multi-user.target
